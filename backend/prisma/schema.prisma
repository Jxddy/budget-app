// Schéma Prisma complet pour l'application Budget Manager
// Base de données: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// MODÈLE UTILISATEUR
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  avatarUrl     String?
  
  // Préférences
  currency      String    @default("EUR")
  locale        String    @default("fr-FR")
  darkMode      Boolean   @default(false)
  
  // Notifications
  emailNotifications    Boolean @default(true)
  alertNotifications    Boolean @default(true)
  
  // Métadonnées
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  budgets       Budget[]
  transactions  Transaction[]
  alerts        Alert[]
  categories    Category[]
  
  @@index([email])
  @@index([isActive])
  @@map("users")
}

// ============================================
// MODÈLE BUDGET
// ============================================

model Budget {
  id              String    @id @default(cuid())
  userId          String
  
  // Informations du budget
  name            String
  description     String?
  month           Int       // 1-12
  year            Int
  totalAmount     Decimal   @db.Decimal(12, 2)
  
  // Statut
  isActive        Boolean   @default(true)
  isArchived      Boolean   @default(false)
  
  // Métadonnées
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subBudgets      SubBudget[]
  
  @@unique([userId, month, year])
  @@index([userId, isActive])
  @@index([userId, year, month])
  @@map("budgets")
}

// ============================================
// MODÈLE SOUS-BUDGET
// ============================================

enum SubBudgetCategory {
  SAVINGS           // Épargne
  INVESTMENT        // Investissement
  DAILY_EXPENSES    // Dépenses courantes
  BILLS             // Factures
  RENT              // Loyer
  ENTERTAINMENT     // Divertissement
  TRANSPORTATION    // Transport
  FOOD              // Alimentation
  HEALTH            // Santé
  EDUCATION         // Éducation
  SHOPPING          // Achats
  TRAVEL            // Voyages
  SPORT             // Sport
  GIFTS             // Cadeaux
  PETS              // Animaux
  OTHER             // Autre
}

model SubBudget {
  id              String              @id @default(cuid())
  budgetId        String
  
  // Informations du sous-budget
  name            String
  description     String?
  category        SubBudgetCategory
  
  // Montants
  targetAmount    Decimal             @db.Decimal(12, 2)
  currentAmount   Decimal             @default(0) @db.Decimal(12, 2)
  
  // Apparence
  color           String              @default("#3B82F6")
  icon            String              @default("💰")
  
  // Alertes
  alertThreshold  Int                 @default(80) // Pourcentage (0-100)
  alertEnabled    Boolean             @default(true)
  
  // Ordre d'affichage
  order           Int                 @default(0)
  
  // Métadonnées
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  budget          Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  
  @@index([budgetId])
  @@index([budgetId, isActive])
  @@index([category])
  @@map("sub_budgets")
}

// ============================================
// MODÈLE TRANSACTION
// ============================================

enum TransactionType {
  INCOME    // Revenu
  EXPENSE   // Dépense
}

enum TransactionStatus {
  PENDING     // En attente
  COMPLETED   // Complété
  CANCELLED   // Annulé
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  subBudgetId     String?
  categoryId      String?
  
  // Informations de la transaction
  type            TransactionType
  status          TransactionStatus @default(COMPLETED)
  amount          Decimal           @db.Decimal(12, 2)
  description     String
  notes           String?
  
  // Informations supplémentaires
  date            DateTime          @default(now())
  transactionDate DateTime          @default(now()) // Date réelle de la transaction
  
  // Classification
  tags            String[]
  location        String?
  merchant        String?
  
  // Pièces jointes
  attachmentUrl   String?
  receiptUrl      String?
  
  // Récurrence
  isRecurring     Boolean           @default(false)
  recurringId     String?
  
  // Métadonnées
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subBudget       SubBudget?        @relation(fields: [subBudgetId], references: [id], onDelete: SetNull)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  
  @@index([userId, date])
  @@index([userId, type])
  @@index([subBudgetId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([isRecurring, recurringId])
  @@map("transactions")
}

// ============================================
// MODÈLE CATÉGORIE PERSONNALISÉE
// ============================================

model Category {
  id              String    @id @default(cuid())
  userId          String
  
  // Informations de la catégorie
  name            String
  description     String?
  
  // Apparence
  color           String    @default("#6B7280")
  icon            String    @default("📁")
  
  // Métadonnées
  isDefault       Boolean   @default(false)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  
  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

// ============================================
// MODÈLE TRANSACTION RÉCURRENTE
// ============================================

enum RecurringFrequency {
  DAILY       // Quotidien
  WEEKLY      // Hebdomadaire
  BIWEEKLY    // Bimensuel
  MONTHLY     // Mensuel
  QUARTERLY   // Trimestriel
  YEARLY      // Annuel
}

model RecurringTransaction {
  id              String              @id @default(cuid())
  userId          String
  
  // Configuration de la récurrence
  name            String
  description     String?
  type            TransactionType
  amount          Decimal             @db.Decimal(12, 2)
  frequency       RecurringFrequency
  
  // Dates
  startDate       DateTime
  endDate         DateTime?
  nextDate        DateTime
  lastExecutedAt  DateTime?
  
  // Configuration
  isActive        Boolean             @default(true)
  autoExecute     Boolean             @default(false)
  
  // Métadonnées
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  transactions    Transaction[]
  
  @@index([userId, isActive])
  @@index([nextDate, isActive])
  @@map("recurring_transactions")
}

// ============================================
// MODÈLE ALERTE
// ============================================

enum AlertType {
  BUDGET_LIMIT      // Limite de budget atteinte
  GOAL_REACHED      // Objectif atteint
  LOW_BALANCE       // Solde faible
  OVERSPENDING      // Dépassement
  RECURRING_DUE     // Transaction récurrente à venir
  MONTHLY_SUMMARY   // Résumé mensuel
  CUSTOM            // Personnalisée
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Alert {
  id              String          @id @default(cuid())
  userId          String
  
  // Informations de l'alerte
  type            AlertType
  priority        AlertPriority   @default(MEDIUM)
  title           String
  message         String
  
  // Données associées
  metadata        Json?           // Données JSON flexibles
  actionUrl       String?         // URL d'action
  
  // Statut
  isRead          Boolean         @default(false)
  isDismissed     Boolean         @default(false)
  readAt          DateTime?
  
  // Métadonnées
  createdAt       DateTime        @default(now())
  expiresAt       DateTime?
  
  // Relations
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("alerts")
}

// ============================================
// MODÈLE OBJECTIF D'ÉPARGNE
// ============================================

enum GoalStatus {
  IN_PROGRESS   // En cours
  COMPLETED     // Atteint
  CANCELLED     // Annulé
  PAUSED        // En pause
}

model SavingsGoal {
  id              String      @id @default(cuid())
  userId          String
  subBudgetId     String?     @unique
  
  // Informations de l'objectif
  name            String
  description     String?
  targetAmount    Decimal     @db.Decimal(12, 2)
  currentAmount   Decimal     @default(0) @db.Decimal(12, 2)
  
  // Apparence
  icon            String      @default("🎯")
  color           String      @default("#10B981")
  imageUrl        String?
  
  // Dates
  startDate       DateTime    @default(now())
  targetDate      DateTime?
  completedAt     DateTime?
  
  // Statut
  status          GoalStatus  @default(IN_PROGRESS)
  priority        Int         @default(0)
  
  // Métadonnées
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([userId, status])
  @@index([targetDate])
  @@map("savings_goals")
}

// ============================================
// MODÈLE PARAMÈTRES UTILISATEUR
// ============================================

model UserSettings {
  id              String    @id @default(cuid())
  userId          String    @unique
  
  // Préférences d'affichage
  theme           String    @default("light")
  compactView     Boolean   @default(false)
  showDecimal     Boolean   @default(true)
  
  // Préférences de budget
  budgetStartDay  Int       @default(1) // Jour de début du mois budgétaire
  defaultCurrency String    @default("EUR")
  
  // Notifications
  emailWeeklySummary    Boolean @default(true)
  emailMonthlySummary   Boolean @default(true)
  emailAlerts           Boolean @default(true)
  pushNotifications     Boolean @default(true)
  
  // Sécurité
  twoFactorEnabled      Boolean @default(false)
  sessionTimeout        Int     @default(30) // minutes
  
  // Export/Backup
  autoBackupEnabled     Boolean @default(false)
  autoBackupFrequency   String? // 'daily', 'weekly', 'monthly'
  lastBackupAt          DateTime?
  
  // Métadonnées
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("user_settings")
}

// ============================================
// MODÈLE AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

model AuditLog {
  id              String      @id @default(cuid())
  userId          String?
  
  // Informations de l'action
  action          AuditAction
  entity          String      // 'budget', 'transaction', etc.
  entityId        String?
  
  // Détails
  changes         Json?       // Anciennes et nouvelles valeurs
  metadata        Json?
  
  // Contexte
  ipAddress       String?
  userAgent       String?
  
  // Métadonnées
  createdAt       DateTime    @default(now())
  
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}
